# ─────────────────────────────────────────────────────────────────────────────
# EDUZY Website CMS — environment variables
# Copy to .env.local for local development. Set the same variables in your hosting
# provider (e.g. Vercel → Project → Settings → Environment Variables) for production.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED in production: secret used to sign admin sessions (min. 32 random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CMS_SESSION_SECRET=

# REQUIRED in production to create the first owner account at /admin/setup.
# Anyone who knows this code can create the first admin, so remove it after setup.
CMS_SETUP_TOKEN=

# ── Content database (MongoDB) ───────────────────────────────────────────────
# Without MONGODB_URI the CMS stores content in local JSON files (.cms-data/),
# which is for development only and does NOT persist on serverless hosting.
MONGODB_URI=
MONGODB_DB=eduzy_cms

# ── Images (Cloudinary) ──────────────────────────────────────────────────────
# Either CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or the three separate variables. Without them, uploads are stored in .cms-data/uploads
# (development only). Secrets are only used on the server.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder in Cloudinary (default: eduzy)
CLOUDINARY_FOLDER=eduzy

# ── Password-reset emails (optional, via Resend) ─────────────────────────────
RESEND_API_KEY=
CMS_EMAIL_FROM="EDUZY Website <no-reply@eduzycampus.com>"

# ── Local development only ───────────────────────────────────────────────────
# Folder for the local content/media adapter (default: .cms-data)
# CMS_DATA_DIR=.cms-data
